# =============================================================================
# AATS / RDP 定时任务 — WSL2 Ubuntu (arthur)
# 安装时间: 2026-04-09
# 项目根: /home/arthur/aats
# Python:  /home/arthur/aats-venv/bin/python
# 日志:    /home/arthur/aats/logs/rdp/
#
# 安装方式:
#   crontab ~/aats/deploy/wsl2-dev/crontab.arthur
#
# 前提:
#   1. cron 服务已启动: systemctl is-active cron
#   2. Docker 容器已启动 (Postgres 等): docker compose up -d
#   3. 日志目录已创建: mkdir -p ~/aats/logs/rdp
#   4. WSL2 native checkout 已同步: cd ~/aats && git pull
# =============================================================================

SHELL=/bin/bash
PATH=/home/arthur/aats-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── RDP Workflow 调度 ──────────────────────────────────────────────────

# 1) 日批数据采集 + artifact 索引重建 — 每天 04:00 UTC
0 4 * * * cd /home/arthur/aats && /home/arthur/aats-venv/bin/python scripts/rdp_run_scheduled_workflow.py --workflow data_maintenance >> logs/rdp/data_maintenance.log 2>&1

# 2) 治理周期: 质量监控 + 产物验证 + 轮次刷新 — 每天 07:00 UTC
0 7 * * * cd /home/arthur/aats && /home/arthur/aats-venv/bin/python scripts/rdp_run_scheduled_workflow.py --workflow governance_cycle >> logs/rdp/governance_cycle.log 2>&1

# 3) 研究周期: Step2 研究 + Phase3 归因 + Phase4 执行 — 每周日 08:00 UTC
0 8 * * 0 cd /home/arthur/aats && /home/arthur/aats-venv/bin/python scripts/rdp_run_scheduled_workflow.py --workflow research_cycle >> logs/rdp/research_cycle.log 2>&1

# 4) 决策周期: Decision round + 可靠性 + 观察检查 — 每周日 10:00 UTC (研究后)
0 10 * * 0 cd /home/arthur/aats && /home/arthur/aats-venv/bin/python scripts/rdp_run_scheduled_workflow.py --workflow decision_cycle >> logs/rdp/decision_cycle.log 2>&1

# ── Postgres 备份 ─────────────────────────────────────────────────────

# 5) 每 30 分钟备份一次 (保留 14 天)
*/30 * * * * cd /home/arthur/aats && ./deploy/wsl2-dev/scripts/backup_postgres.sh >> logs/rdp/backup.log 2>&1

# ── 健康检查 ──────────────────────────────────────────────────────────

# 6) 每小时巡检一次, 所有任务状态汇总到 healthcheck.log
0 * * * * cd /home/arthur/aats && ./deploy/wsl2-dev/scripts/cron_healthcheck.sh >> logs/rdp/healthcheck.log 2>&1
