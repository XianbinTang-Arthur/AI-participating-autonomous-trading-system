# ============================================================================
# AATS WSL2 dev infra — 环境变量模板
#
# 用法：
#   1. cp .env.wsl2.template .env.wsl2
#   2. 根据需要修改密码等敏感字段
#   3. .env.wsl2 已在 .gitignore 排除，不会被提交
#
# 这些变量供 docker-compose 拉起基础设施使用（Postgres / Grafana）。
# AATS 应用进程的配置在项目根目录的 .env.<profile> 文件中。
# ============================================================================

# ---- Postgres ----
# 用户名和密码用于 Postgres 容器初始化和 AATS 应用连接数据库。
# 数据库名称由各 .env.<profile> 的 AATS_DB_NAME 决定，不在此处设置。
POSTGRES_DB=aats
POSTGRES_USER=aats
POSTGRES_PASSWORD=aats_dev_change_me

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_change_me
