# ============================================================================
# AATS WSL2 dev infra — 环境变量模板
#
# 用法：
#   1. cp .env.wsl2.template .env.wsl2
#   2. 根据需要修改密码等敏感字段
#   3. .env.wsl2 已在 .gitignore 排除，不会被提交
#
# 这些变量只供 docker-compose 拉起本地依赖使用，
# AATS 应用进程的 .env 是另外一份（由 apps/*/main.py 通过 load_settings 读取）。
# ============================================================================

# ---- Postgres ----
POSTGRES_DB=aats
POSTGRES_USER=aats
POSTGRES_PASSWORD=aats_dev_change_me

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_change_me
