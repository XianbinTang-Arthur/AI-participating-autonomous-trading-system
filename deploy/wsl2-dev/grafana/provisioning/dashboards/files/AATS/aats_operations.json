  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 50,
      "title": "Runtime Governance (P0-b)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P0-b Task 2.2: 当前 ai_operating_mode → decision_authority 视图. 对齐 docs/governance/runtime_trading_mode_semantics.md §1-§2. Prometheus 采到带 mode label 的样本就显示. 2026-04-20 update: Prometheus scrape 已修复 (commit 3c90c64, 6/6 targets UP), P1 遗留条件已消除. legacy alias (ai_advisory/ai_blended/ai_primary/ai_decision_maker_with_profile_control) 会 normalize 到 canonical 三态后展示.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "baseline_only": { "text": "REFERENCE ONLY (不下单)", "color": "blue", "index": 0 },
                "ai_assisted": { "text": "ADVISORY (实盘)", "color": "orange", "index": 1 },
                "ai_decision_maker": { "text": "FINAL DECISION (AI 实盘)", "color": "red", "index": 2 },
                "ai_advisory": { "text": "ADVISORY (实盘) [legacy alias]", "color": "orange", "index": 3 },
                "ai_blended": { "text": "ADVISORY (实盘) [legacy alias]", "color": "orange", "index": 4 },
                "ai_primary": { "text": "FINAL DECISION (AI 实盘) [legacy alias]", "color": "red", "index": 5 },
                "ai_decision_maker_with_profile_control": { "text": "FINAL DECISION (AI 实盘) [legacy alias]", "color": "red", "index": 6 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "noValue": "No Data — 检查 Prometheus scrape (/metrics) + aats_runtime_ai_operating_mode counter 是否在 emit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 1 },
      "id": 11,
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^mode$/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "group by (mode) (aats_runtime_ai_operating_mode_total)",
          "instant": true,
          "legendFormat": "{{mode}}",
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT payload::jsonb->>'ai_operating_mode' AS mode FROM public.event_store WHERE topic='strategy.decision_outcome' ORDER BY event_timestamp DESC LIMIT 1",
          "refId": "B",
          "hide": false
        }
      ],
      "title": "Runtime Trading Mode (当前授权)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 100,
      "title": "Process Health",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum by (process_role) (count_over_time({job=\"aats\", process_role=~\"${process_role:pipe}\"} [$__interval]))",
          "legendFormat": "{{process_role}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Process Heartbeat (log volume)",
      "description": "Each process should continuously emit logs. A line dropping to 0 means the process is down or silent.",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 200,
      "title": "Core Metrics (Prometheus)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(aats_decision_cycles_total[1m])) * 60",
          "legendFormat": "cycles/min",
          "refId": "A"
        }
      ],
      "title": "Decision Cycles / min",
      "description": "Stage 9 requirement: >= 1 per minute",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(aats_fills_processed_total[1h]))",
          "legendFormat": "fills/hour",
          "refId": "A"
        }
      ],
      "title": "Fill Events / hour",
      "description": "Stage 9 requirement: ratio to order_intents > 0.8",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(aats_fills_processed_total[5m])) / clamp_min(sum(rate(aats_order_intents_generated_total[5m])), 0.001)",
          "legendFormat": "fill rate",
          "refId": "A"
        }
      ],
      "title": "Fill Success Rate",
      "description": "Stage 9 requirement: >= 98%",
      "type": "gauge"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 300,
      "title": "Infrastructure",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 21 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  now() AS time,\n  count(*) FILTER (WHERE state = 'idle') AS idle,\n  count(*) FILTER (WHERE state = 'active') AS active\nFROM pg_stat_activity\nWHERE datname = current_database()",
          "refId": "A"
        }
      ],
      "title": "Postgres Connections",
      "description": "Stage 9 requirement: idle count >= 2",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 21 },
      "id": 10,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(redis_commands_duration_seconds_total[5m])) / clamp_min(sum(rate(redis_commands_total[5m])), 0.001) * 1000",
          "legendFormat": "avg latency",
          "refId": "A"
        }
      ],
      "title": "Redis Command Latency",
      "description": "Stage 9 requirement: p99 < 10ms. Average command latency from redis-exporter; red threshold at 10ms.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 21 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(aats_reconciliation_mismatches_total[5m])) * 300",
          "legendFormat": "mismatches/5m",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(aats_processing_failures_total[5m])) * 300",
          "legendFormat": "failures/5m",
          "refId": "B"
        }
      ],
      "title": "Reconciliation & Processing Failures",
      "type": "timeseries"
    },

    {
