# 指定当前运行环境名称，通常本地开发保持 dev。
AATS_ENVIRONMENT=dev

# 指定当前加载的配置档案名称，本示例默认使用 local_demo。
AATS_CONFIG_PROFILE=local_demo

# 指定系统运行模式，本示例默认使用 paper_live。
AATS_MODE=paper_live

# 指定 API 服务监听地址，本机访问通常保持 127.0.0.1。
AATS_API_HOST=127.0.0.1

# 指定 API 服务监听端口，浏览器默认访问这个端口。
AATS_API_PORT=8000

# 指定主决策周期，当前策略主周期使用 15m。
AATS_PRIMARY_TIMEFRAME=15m

# 指定辅助决策周期，当前用 1h 做高一级趋势参考。
AATS_SECONDARY_TIMEFRAME=1h

# 指定真正启用决策的周期列表，本示例只在 15m 上触发决策。
AATS_ENABLED_DECISION_TIMEFRAMES=["15m"]

# 指定本地初始资金，仅在本地演示或 paper 场景下有意义。
AATS_INITIAL_USDT_BALANCE=10000

# 指定事件持久化策略，strict 表示关键事件必须落库。
AATS_EVENT_PERSISTENCE_MODE=strict

# 指定启动时是否尝试从交易所账户状态初始化本地组合快照，本示例关闭。
AATS_BOOTSTRAP_PORTFOLIO_FROM_EXCHANGE=false

# 指定市场数据后端，本示例使用本地 demo 市场数据。
AATS_MARKET_DATA_BACKEND=demo

# 指定执行后端，本示例使用 paper 执行器。
AATS_EXECUTION_BACKEND=paper

# 指定账户读取后端，本示例不接真实账户。
AATS_ACCOUNT_BACKEND=disabled

# 指定是否启用账户读取，本示例关闭。
AATS_ACCOUNT_READ_ENABLED=false

# 指定是否允许真实提交到执行后端，本示例保持关闭。
AATS_LIVE_SUBMIT_ENABLED=false

# 指定 guarded 执行是否只做演练不真正提交，本示例保持 true。
AATS_GUARDED_EXECUTION_DRY_RUN=true

# 指定交易姿态的产品类型，本示例默认使用现货。
AATS_TRADING_PRODUCT_TYPE=spot

# 指定保证金模式，现货模式下保持 cash。
AATS_MARGIN_MODE=cash

# 指定默认交易标的，本示例使用 BTC-USDT。
AATS_DEFAULT_SYMBOL=BTC-USDT

# 指定允许交易的标的列表，当前仅允许 BTC-USDT。
AATS_ALLOWED_SYMBOLS=["BTC-USDT"]

# 指定默认下单数量，作为目标仓位计算的基础粒度。
AATS_DEFAULT_ORDER_QTY=0.001

# 指定单品种允许的最大绝对仓位数量。
AATS_MAX_ABS_POSITION_QTY=0.003

# 指定单品种允许的最大名义价值上限，单位通常为 USDT。
AATS_MAX_NOTIONAL_PER_SYMBOL=250

# 指定同一时刻允许存在的最大未完成挂单数量。
AATS_MAX_OPEN_ORDERS=2

# 指定允许使用的最大目标杠杆倍数，现货保持 1。
AATS_MAX_TARGET_LEVERAGE=1

# 指定默认目标杠杆倍数，现货保持 1。
AATS_DEFAULT_TARGET_LEVERAGE=1

# 指定是否允许策略生成空头方向偏置，现货模式默认关闭。
AATS_STRATEGY_SHORT_BIAS_ENABLED=false

# 指定是否允许策略根据信号强弱动态调整杠杆，现货模式默认关闭。
AATS_STRATEGY_DYNAMIC_LEVERAGE_ENABLED=false

# 指定存储模式，本示例默认使用 memory。
AATS_STORAGE_MODE=memory

# 指定 PostgreSQL 连接串，切换到 postgres 持久化时需要填写正确值。
AATS_DATABASE_URL=postgresql+psycopg://aats:aats@localhost:5432/aats

# 指定启动时是否自动补齐 ORM 需要的数据库表结构。
AATS_DATABASE_AUTO_CREATE_SCHEMA=true

# 指定允许的最大保证金使用比例，避免仓位过满。
AATS_MAX_MARGIN_USAGE_FRACTION=0.85

# 指定强平缓冲比例，为风控预留安全边界。
AATS_LIQUIDATION_BUFFER_FRACTION=0.15

# 指定本地发布循环次数，主要给 demo / paper 数据节奏使用。
AATS_LOCAL_PUBLISH_ITERATIONS=6

# 指定本地发布循环间隔秒数，0 表示尽快连续发布。
AATS_LOCAL_PUBLISH_INTERVAL_SECONDS=0

# 指定 paper 执行默认 taker 手续费基点。
AATS_PAPER_TAKER_FEE_BPS=5

# 指定 AI 工作模式，baseline_only 表示只跑基线策略不真正调用 AI 决策。
AATS_AI_OPERATING_MODE=baseline_only

# 指定 AI 提供方，disabled 表示完全关闭外部 AI 调用。
AATS_AI_PROVIDER=disabled

# 指定 AI 模型名称，保留为后续启用 AI 时的默认模型。
AATS_AI_MODEL_NAME=gpt-4o-mini

# 指定 AI 提示词版本号，便于审计和回放。
AATS_AI_PROMPT_VERSION=0.2.0

# 指定 AI 模型版本号，便于定位行为差异。
AATS_AI_MODEL_VERSION=1.0.0

# 指定单次 AI 调用超时时间，单位为秒。
AATS_AI_TIMEOUT_SECONDS=5

# 指定 AI 调用失败后的最大重试次数。
AATS_AI_MAX_RETRIES=0

# 指定连续失败多少次后降级为非 AI 模式。
AATS_AI_DEGRADE_AFTER_FAILURES=3

# 指定连续成功多少次后允许从降级状态恢复。
AATS_AI_RECOVER_AFTER_SUCCESSES=2

# 指定主 AI 决策最小置信度阈值。
AATS_AI_PRIMARY_MIN_CONFIDENCE=0.6

# 指定 OpenAI API Key，仅在启用 OpenAI 时会用到。
AATS_OPENAI_API_KEY=

# 指定 OpenAI 兼容接口基地址。
AATS_OPENAI_BASE_URL=https://api.openai.com

# 指定市场数据多久算过期，单位为秒。
AATS_MARKET_DATA_STALE_AFTER_SECONDS=30

# 指定账户状态多久算过期，单位为秒。
AATS_ACCOUNT_STATE_STALE_AFTER_SECONDS=60

# 指定对账结果多久算过期，单位为秒。
AATS_RECONCILIATION_STALE_AFTER_SECONDS=300

# 指定 OKX REST 接口地址。
AATS_OKX_REST_URL=https://www.okx.com

# 指定 OKX 公共频道 WebSocket 地址。
AATS_OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public

# 指定 OKX 业务频道 WebSocket 地址。
AATS_OKX_BUSINESS_WS_URL=wss://ws.okx.com:8443/ws/v5/business

# 指定 OKX API Key，接 OKX 时请填入真实值。
AATS_OKX_API_KEY=

# 指定 OKX API Secret，接 OKX 时请填入真实值。
AATS_OKX_API_SECRET=

# 指定 OKX API Passphrase，接 OKX 时请填入真实值。
AATS_OKX_API_PASSPHRASE=

# 指定是否启用 OKX 模拟交易环境，本示例默认关闭。
AATS_OKX_SIMULATED_TRADING=false

# 指定 OKX HTTP / WS 调用的统一超时时间，单位为秒。
AATS_OKX_TIMEOUT_SECONDS=10

# 指定 OKX 市场数据断线后的重连等待秒数。
AATS_OKX_MARKET_RECONNECT_DELAY_SECONDS=2

# 指定 OKX 账户刷新轮询间隔，单位为秒。
AATS_OKX_ACCOUNT_REFRESH_INTERVAL_SECONDS=15

# 指定 OKX 执行状态同步轮询间隔，单位为秒。
AATS_OKX_EXECUTION_SYNC_INTERVAL_SECONDS=5

# 指定单次向 OKX 拉取 fills 的数量上限。
AATS_OKX_FILL_FETCH_LIMIT=100

# 指定是否启用浏览器登录鉴权，true 时根路径会先进入登录页。
AATS_OPERATOR_AUTH_ENABLED=false

# 指定无登录状态下是否允许危险写操作，建议保持 false。
AATS_OPERATOR_UNSAFE_WRITE_WITHOUT_AUTH=false

# 指定是否允许从 docs/user.txt 做一次性 bootstrap，本示例关闭。
AATS_OPERATOR_BOOTSTRAP_ENABLED=false

# 指定 session 签名密钥，启用登录页后请填入随机长字符串。
AATS_OPERATOR_SESSION_SECRET=

# 指定浏览器登录态 cookie 名称。
AATS_OPERATOR_SESSION_COOKIE_NAME=aats_operator_session

# 指定浏览器登录态有效期，单位为秒。
AATS_OPERATOR_SESSION_MAX_AGE_SECONDS=43200

# 指定 cookie 是否只在 HTTPS 下发送，本地 http 调试保持 false。
AATS_OPERATOR_SESSION_COOKIE_SECURE=false

# 指定日志级别，INFO 适合日常运行观察。
AATS_LOG_LEVEL=INFO

# 指定日志输出目录。
AATS_LOG_DIR=logs

# 指定单个日志文件最大体积，单位为字节。
AATS_LOG_ROTATE_MAX_BYTES=5242880

# 指定保留的历史日志文件数量。
AATS_LOG_BACKUP_COUNT=7
