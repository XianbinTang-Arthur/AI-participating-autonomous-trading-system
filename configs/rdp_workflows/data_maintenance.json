{
  "workflow": "data_maintenance",
  "description": "数据层维护: 日批 OKX 增量采集、gap detection、gold build、数据完整性检查",
  "schedule_hint": "daily 04:00 UTC",
  "tasks": [
    {
      "name": "daily_ingest",
      "description": "日批从 OKX REST 拉取昨日全部 candles + funding (替代废弃的 realtime daemon), 含 Gold 构建和 Gap 检测",
      "command": "python scripts/rdp_run_daily_ingest.py",
      "timeout_seconds": 900,
      "enabled": true,
      "allow_failure": false
    },
    {
      "name": "gap_detection",
      "description": "检测 Bronze 层数据缺口 (额外检查, daily_ingest 内部已经做过)",
      "command": "python -m aats.data_platform.validate.gap_detector --check",
      "timeout_seconds": 120,
      "enabled": true,
      "allow_failure": true
    },
    {
      "name": "gold_build",
      "description": "构建 Gold 层聚合数据 (额外检查, daily_ingest 内部已经做过)",
      "command": "python -m aats.data_platform.gold.builder --incremental",
      "timeout_seconds": 300,
      "enabled": true,
      "allow_failure": true
    },
    {
      "name": "artifact_index_rebuild",
      "description": "重建 artifact 索引",
      "command": "python -m aats.data_platform.governance.artifact_indexer --rebuild",
      "timeout_seconds": 60,
      "enabled": true,
      "allow_failure": true
    }
  ]
}
