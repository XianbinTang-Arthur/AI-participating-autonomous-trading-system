{
  "workflow": "data_maintenance",
  "description": "数据层维护: 日批 OKX 增量采集 (含内置 Gold 构建 + Gap 检测) + artifact 索引重建",
  "schedule_hint": "daily 04:00 UTC",
  "tasks": [
    {
      "name": "daily_ingest",
      "description": "日批从 OKX REST 拉取昨日全部 candles + funding (替代废弃的 realtime daemon), 含 Gold 构建和 Gap 检测",
      "command": "python scripts/rdp_run_daily_ingest.py",
      "timeout_seconds": 900,
      "enabled": true,
      "allow_failure": false
    },
    {
      "name": "artifact_index_rebuild",
      "description": "重建 artifact 索引",
      "command": "python -m aats.data_platform.governance.artifact_indexer --validate",
      "timeout_seconds": 60,
      "enabled": true,
      "allow_failure": true
    }
  ]
}
