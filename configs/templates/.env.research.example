# Research Data Platform (RDP) 环境配置模板
# 复制本文件到项目根目录并重命名为 .env.research，然后填入实际值。
# 所有字段以 RDP_ 前缀读取。

# 数据库
# [运行必改] RDP_DATABASE_URL：PostgreSQL 连接串。数仓独立于交易系统分库。
# 可选值：合法的 postgresql+psycopg 连接串。
# 推荐值：postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aats_research
RDP_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aats_research

# OKX API（Rolling 增量采集用）
# [可选] RDP_OKX_REST_URL：OKX REST API 地址。默认 https://www.okx.com
# RDP_OKX_REST_URL=https://www.okx.com
# [可选] RDP_OKX_TIMEOUT_SECONDS：API 超时（秒）。默认 15。
# RDP_OKX_TIMEOUT_SECONDS=15
# [可选] RDP_OKX_RATE_LIMIT_SLEEP：API 请求间隔（秒）。默认 0.12（~8 req/s）。
# RDP_OKX_RATE_LIMIT_SLEEP=0.12

# 历史文件目录
# [可选] RDP_HISTORICAL_DOWNLOAD_DIR：OKX 历史文件下载根目录。
# RDP_HISTORICAL_DOWNLOAD_DIR=./data/historical

# Rolling 采集开关
# [可选] RDP_ROLLING_CANDLES_ENABLED：是否启用滚动 candles 采集。默认 true。
# RDP_ROLLING_CANDLES_ENABLED=true
# [可选] RDP_ROLLING_FUNDING_ENABLED：是否启用滚动 funding 采集。默认 true。
# RDP_ROLLING_FUNDING_ENABLED=true

# Gold 构建
# [可选] RDP_GOLD_REPLAY_BUILD_ENABLED：是否启用 Gold 层构建。默认 true。
# RDP_GOLD_REPLAY_BUILD_ENABLED=true
