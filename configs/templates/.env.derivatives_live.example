# AATS derivatives_live 最小 override 模板
# 这个文件只放用户/账户私有 override，不再复制整份 settings。
# 运行时基线由代码内 managed profile 自动派生：guarded_derivatives_enabled / guarded_live
# 策略调参请改：configs/strategy_profiles/derivatives_live.yaml
# 下面没有写到的字段，会回落到 settings.py 默认值或该 profile 的代码基线。

# 交易标的与账户规模
# 这里放你最常改、且和账户资金/交易标的直接相关的 override。
# 默认交易标的。改标的先改这里。
AATS_DEFAULT_SYMBOL=BTC-USDT-SWAP
# 允许交易的标的列表。单标的运行建议只保留一个。
AATS_ALLOWED_SYMBOLS=["BTC-USDT-SWAP"]
# 本地组合初始 USDT 口径。实盘建议填你准备给这套系统使用的资金规模。
AATS_INITIAL_USDT_BALANCE=100

# 数据库与运行实例
# 这里放每个运行实例都不同的基础设施参数。
# PostgreSQL 连接串。现货/合约建议分库。
AATS_DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/aats_live_derivatives
# 数据库单实例锁键。现货/合约请保持不同。
AATS_DATABASE_RUNTIME_LOCK_KEY=42420021
# API/UI 端口。并行跑多个实例时必须不同。
AATS_API_PORT=8011
# 日志目录。建议按 profile 分开。
AATS_LOG_DIR=logs/live_derivatives

# 交易所与凭证
# 这里只放密钥与会话密钥，不放策略调参。
# OpenAI 密钥。只有 strategy profile 里 ai_provider=openai 时才会实际使用。
AATS_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# OKX API Key。
AATS_OKX_API_KEY=REPLACE_WITH_REAL_OKX_API_KEY
# OKX API Secret。
AATS_OKX_API_SECRET=REPLACE_WITH_REAL_OKX_API_SECRET
# OKX API Passphrase。
AATS_OKX_API_PASSPHRASE=REPLACE_WITH_REAL_OKX_API_PASSPHRASE
# Operator 会话密钥。请换成足够长的随机串。
AATS_OPERATOR_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_OPERATOR_SESSION_SECRET
# Operator cookie 名称。并行跑多个实例时建议不同。
AATS_OPERATOR_SESSION_COOKIE_NAME=aats_operator_session_derivatives_live

# 合约实盘仓位、杠杆与风控上限
# 这里只放账户级风险边界；进出场阈值和自动换档去 strategy_profiles/derivatives_live.yaml 改。
# 默认单笔下单数量。
AATS_DEFAULT_ORDER_QTY=0.01
# 单标的最大绝对持仓数量。
AATS_MAX_ABS_POSITION_QTY=0.02
# 单标的最大名义金额。
AATS_MAX_NOTIONAL_PER_SYMBOL=1000
# 最多同时挂单数。
AATS_MAX_OPEN_ORDERS=5
# 最大目标杠杆。
AATS_MAX_TARGET_LEVERAGE=10
# 默认目标杠杆。
AATS_DEFAULT_TARGET_LEVERAGE=5
# 达到该保证金占用比例后只允许减仓。
AATS_DERIVATIVES_ONLY_REDUCE_TRIGGER_MARGIN_FRACTION=0.65
# 达到该保证金占用比例后自动暂停。
AATS_DERIVATIVES_AUTO_HALT_MARGIN_USAGE_FRACTION=0.75
# 距强平过近时自动暂停。
AATS_DERIVATIVES_AUTO_HALT_LIQUIDATION_GAP_FRACTION=0.10
# 预估保证金占用上限。
AATS_MAX_MARGIN_USAGE_FRACTION=0.75
# 强平缓冲比例。
AATS_LIQUIDATION_BUFFER_FRACTION=0.20

# 提示
# 1. 不要再把 AATS_CONFIG_PROFILE、AATS_TRADING_PRODUCT_TYPE、AATS_MARGIN_MODE 写回这个文件。
# 2. 若要调节 AI、自动换档、directional / smart_arbitrage / spot_grid / dca，请去对应 strategy_profiles/*.yaml。
