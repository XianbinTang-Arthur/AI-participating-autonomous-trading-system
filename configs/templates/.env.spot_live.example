# AATS spot_live 最小 override 模板
# 这个文件只放用户/账户私有 override，不再复制整份 settings。
# 运行时基线由代码内 managed profile 自动派生：guarded_spot_enabled / guarded_live
# 策略调参请改：configs/strategy_profiles/spot_live.yaml
# 下面没有写到的字段，会回落到 settings.py 默认值或该 profile 的代码基线。

# 交易标的
# 这里放你最常改、且和交易标的直接相关的 override。账户可用余额由实时账户快照提供，不在 .env 模板里填写本金。
# [运行必改] AATS_DEFAULT_SYMBOL：默认交易标的。改标的先改这里。可选值：交易所支持的现货或合约符号；推荐值：BTC-USDT。
AATS_DEFAULT_SYMBOL=BTC-USDT
# [常用可调] AATS_ALLOWED_SYMBOLS：允许交易的标的列表。单标的运行建议只保留一个。可选值：JSON 数组；推荐单标的只保留一个；推荐值：["BTC-USDT"]。
AATS_ALLOWED_SYMBOLS=["BTC-USDT"]

# 数据库与运行实例
# 这里放每个运行实例都不同的基础设施参数。
# [运行必改] AATS_DATABASE_URL：PostgreSQL 连接串。现货/合约建议分库。可选值：合法的 postgresql+psycopg 连接串；推荐值：postgresql+psycopg://postgres:123456@localhost:5432/aats_example。
AATS_DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/aats_live_spot
# [运行必改] AATS_DATABASE_RUNTIME_LOCK_KEY：数据库单实例锁键。现货/合约请保持不同。可选值：正整数；推荐值：42420001。
AATS_DATABASE_RUNTIME_LOCK_KEY=42420011
# [运行必改] AATS_API_PORT：API/UI 端口。并行跑多个实例时必须不同。可选值：未占用端口；推荐值：8000。
AATS_API_PORT=8010
# [运行必改] AATS_LOG_DIR：日志目录。建议按 profile 分开。可选值：相对或绝对路径；推荐值：logs/example。
AATS_LOG_DIR=logs/live_spot

# 交易所与凭证
# 这里只放密钥与会话密钥，不放策略调参。
# [按需填写] AATS_OPENAI_API_KEY：OpenAI 密钥。只有 strategy profile 里 ai_provider=openai 时才会实际使用。可选值：有效的 OpenAI API Key；若 AI provider=disabled 可留占位值；推荐值：REPLACE_WITH_OPENAI_API_KEY。
AATS_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# [运行必改] AATS_OKX_API_KEY：OKX API Key。可选值：与当前交易环境匹配的真实或模拟盘 Key；推荐值：REPLACE_WITH_REAL_OKX_API_KEY。
AATS_OKX_API_KEY=REPLACE_WITH_REAL_OKX_API_KEY
# [运行必改] AATS_OKX_API_SECRET：OKX API Secret。可选值：与当前 OKX API Key 配套的 Secret；推荐值：REPLACE_WITH_REAL_OKX_API_SECRET。
AATS_OKX_API_SECRET=REPLACE_WITH_REAL_OKX_API_SECRET
# [运行必改] AATS_OKX_API_PASSPHRASE：OKX API Passphrase。可选值：与当前 OKX API Key 配套的 Passphrase；推荐值：REPLACE_WITH_REAL_OKX_API_PASSPHRASE。
AATS_OKX_API_PASSPHRASE=REPLACE_WITH_REAL_OKX_API_PASSPHRASE
# [运行必改] AATS_OPERATOR_SESSION_SECRET：Operator 会话密钥。请换成足够长的随机串。可选值：足够长的随机字符串；推荐值：REPLACE_WITH_LONG_RANDOM_OPERATOR_SESSION_SECRET。
AATS_OPERATOR_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_OPERATOR_SESSION_SECRET
# [常用可调] AATS_OPERATOR_SESSION_COOKIE_NAME：Operator cookie 名称。并行跑多个实例时建议不同。可选值：自定义字符串；推荐值：aats_operator_session_example。
AATS_OPERATOR_SESSION_COOKIE_NAME=aats_operator_session_spot_live

# 现货实盘仓位与下单上限
# 现货 cash 模式固定为 1x；若想调整风格，请改 strategy_profiles/spot_live.yaml。
# [常用可调] AATS_DEFAULT_ORDER_QTY：默认单笔下单数量。可选值：正数；推荐值：0.01。
AATS_DEFAULT_ORDER_QTY=0.01
# [常用可调] AATS_MAX_ABS_POSITION_QTY：单标的最大绝对持仓数量。可选值：正数；推荐值：0.02。
AATS_MAX_ABS_POSITION_QTY=0.02
# [常用可调] AATS_MAX_NOTIONAL_PER_SYMBOL：单标的最大名义金额。可选值：正数；推荐值：1000。
AATS_MAX_NOTIONAL_PER_SYMBOL=1000
# [常用可调] AATS_MAX_OPEN_ORDERS：最多同时挂单数。可选值：1 ~ 20；推荐值：5。
AATS_MAX_OPEN_ORDERS=5

# 提示
# 1. 不要再把 AATS_CONFIG_PROFILE、AATS_TRADING_PRODUCT_TYPE、AATS_MARGIN_MODE 写回这个文件。
# 2. 若要调节 AI、自动换档、directional / smart_arbitrage / spot_grid / dca，请去对应 strategy_profiles/*.yaml。
