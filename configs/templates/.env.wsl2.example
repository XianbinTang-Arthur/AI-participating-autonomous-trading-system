# AATS WSL2 基础设施 — Postgres / Grafana 共享凭证
#
# 用法：
#   1. cp configs/templates/.env.wsl2.example .env.wsl2
#   2. 修改 POSTGRES_USER / POSTGRES_PASSWORD / GRAFANA 密码
#   3. .env.wsl2 已在 .gitignore 排除，不会被提交
#
# 这些变量由 docker-compose 模板层使用：
#   - Postgres 容器初始化时创建超级用户
#   - AATS 应用容器的 AATS_DATABASE_URL 由模板自动拼接（无需手动配置）
#   - Grafana 管理员账号

# ---- Postgres ----
POSTGRES_DB=aats
POSTGRES_USER=aats
POSTGRES_PASSWORD=CHANGE_ME

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
